{
  "name": "perry-parrot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "desktop:dev": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:build": "cross-env ELECTRON_BUILD=true vite build && electron-builder --win nsis --publish never",
    "desktop:pack": "cross-env ELECTRON_BUILD=true vite build && electron-builder --dir"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.4.1",
    "typescript": "^5.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.575.0",
    "pdfjs-dist": "^4.10.38",
    "mammoth": "^1.9.0",
    "tesseract.js": "^6.0.1",
    "@huggingface/transformers": "^3.7.2"
  },
  "devDependencies": {
    "vite-plugin-pwa": "^0.21.1",
    "@playwright/test": "^1.55.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "concurrently": "^9.1.2",
    "wait-on": "^8.0.3",
    "cross-env": "^7.0.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.perryparrot.desktop",
    "productName": "Perry Parrot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
